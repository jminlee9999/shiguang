/* =========================================================
   iPhone PWA additions
   ========================================================= */
.data-pill {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 4px 9px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: rgba(255, 253, 248, 0.55);
  color: var(--muted);
  font-family: inherit;
  font-size: 10px;
  letter-spacing: 0.04em;
  line-height: 1.7;
  white-space: nowrap;
  transition: border-color 0.2s ease, background 0.2s ease, color 0.2s ease;
}

.data-pill .icon {
  width: 11px;
  height: 11px;
  stroke-width: 1.8;
}

.data-pill:hover {
  border-color: rgba(180, 91, 57, 0.3);
  background: var(--accent-soft);
  color: var(--accent-deep);
}

.data-pill.is-overdue::after {
  content: "";
  position: absolute;
  top: -2px;
  right: -2px;
  width: 7px;
  height: 7px;
  border: 1.5px solid var(--bg);
  border-radius: 50%;
  background: var(--accent);
}

.install-banner {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 11px 13px;
  margin-bottom: 20px;
  border: 1px solid rgba(180, 91, 57, 0.18);
  border-radius: 15px;
  background: linear-gradient(100deg, rgba(245, 225, 212, 0.72), rgba(255, 253, 248, 0.72));
  animation: rise 0.45s var(--ease) both;
}

.install-banner-mark {
  display: grid;
  flex: none;
  place-items: center;
  width: 34px;
  height: 34px;
  border-radius: 10px 10px 10px 3px;
  background: linear-gradient(150deg, #c16742, var(--accent-deep));
  color: #fff8ee;
  font-family: var(--font-display);
  font-size: 18px;
  line-height: 1;
  transform: rotate(-2deg);
}

.install-banner-text {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 1px;
  min-width: 0;
}

.install-banner-text strong {
  font-family: var(--font-display);
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.03em;
}

.install-banner-text span {
  color: var(--muted);
  font-size: 10.5px;
  line-height: 1.6;
}

.install-banner-close {
  display: grid;
  flex: none;
  place-items: center;
  width: 25px;
  height: 25px;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: rgba(255, 253, 248, 0.6);
  color: var(--muted);
}

.install-banner-close .icon {
  width: 12px;
  height: 12px;
}

.data-modal {
  width: min(540px, 100%);
}

.data-local-card {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 11px 13px;
  border: 1px solid rgba(93, 124, 87, 0.16);
  border-radius: 13px;
  background: linear-gradient(100deg, rgba(229, 237, 221, 0.62), rgba(255, 253, 248, 0.45));
}

.data-local-stamp {
  display: grid;
  flex: none;
  place-items: center;
  width: 34px;
  height: 34px;
  border-radius: 10px 10px 10px 3px;
  background: var(--green);
  color: #fbf6ec;
  font-family: var(--font-display);
  font-size: 18px;
  line-height: 1;
  transform: rotate(-2deg);
}

.data-local-card strong {
  display: block;
  font-size: 12px;
  font-weight: 600;
}

.data-local-card p {
  margin: 2px 0 0;
  color: var(--muted);
  font-size: 10.5px;
  line-height: 1.6;
}

.data-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8px;
}

.data-stat {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 9px 11px;
  border: 1px solid var(--line);
  border-radius: 11px;
  background: var(--paper-soft);
}

.data-stat span {
  color: var(--muted);
  font-size: 9.5px;
  letter-spacing: 0.04em;
}

.data-stat strong {
  color: var(--ink);
  font-size: 12px;
  font-weight: 600;
  line-height: 1.5;
  word-break: break-word;
}

.data-stat strong.is-overdue {
  color: var(--accent-deep);
}

.data-warning {
  margin: 0;
  padding: 9px 11px;
  border-radius: 10px;
  background: var(--accent-soft);
  color: var(--accent-deep);
  font-size: 10.5px;
  line-height: 1.7;
}

.data-hint {
  margin: 0;
  color: var(--muted);
  font-size: 10.5px;
  line-height: 1.7;
}

.data-install-tip {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  padding: 9px 11px;
  border: 1px dashed var(--line);
  border-radius: 11px;
  color: var(--ink-soft);
  font-size: 10.5px;
  line-height: 1.7;
}

.data-install-tip .icon {
  flex: none;
  width: 14px;
  height: 14px;
  margin-top: 1px;
  color: var(--accent);
}

.data-install-tip p {
  margin: 0;
}

