  font-family: var(--font-display);
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.04em;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 7px;
  width: 232px;
  padding: 0 11px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: rgba(255, 253, 248, 0.7);
  transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
}

.search-box:focus-within {
  border-color: rgba(180, 91, 57, 0.38);
  background: var(--paper);
  box-shadow: 0 0 0 4px rgba(180, 91, 57, 0.06);
}

.search-box .icon {
  width: 15px;
  height: 15px;
  color: var(--faint);
}

.search-box input {
  width: 100%;
  padding: 9px 0;
  border: 0;
  outline: none;
  background: transparent;
  font-size: 12px;
}

.search-box input::placeholder {
  color: var(--faint);
}

.search-box input::-webkit-search-cancel-button {
  display: none;
}

.search-clear {
  display: grid;
  flex: none;
  place-items: center;
  width: 18px;
  height: 18px;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: rgba(66, 55, 39, 0.09);
  color: var(--muted);
}

.search-clear .icon {
  width: 11px;
  height: 11px;
  color: inherit;
}

/* ---------- composer ---------- */
.composer {
  position: relative;
  margin-bottom: 30px;
  border: 1px solid var(--line);
  border-radius: 20px;
  background: linear-gradient(180deg, var(--paper), #fdfaf3);
  box-shadow: var(--shadow-sm);
  transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
  animation: rise 0.45s var(--ease) both;
}

.composer:focus-within {
  border-color: rgba(180, 91, 57, 0.32);
  box-shadow: 0 0 0 4px rgba(180, 91, 57, 0.055), var(--shadow-md);
}

.composer-tape {
  position: absolute;
  top: -9px;
  left: 50%;
  width: 88px;
  height: 18px;
  border-radius: 2px;
  background:
    repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.18) 0 6px, transparent 6px 12px),
    rgba(210, 189, 152, 0.42);
  transform: translateX(-50%) rotate(-1.2deg);
  pointer-events: none;
  box-shadow: 0 1px 2px rgba(80, 60, 30, 0.06);
}

.composer-body {
  padding: 19px 21px 14px;
}

.composer-title {
  display: block;
  width: 100%;
  padding: 0 0 3px;
  border: 0;
  outline: none;
  background: transparent;
  font-size: 18px;
  font-weight: 600;
  letter-spacing: 0.01em;
}

.composer-title::placeholder {
  color: #b9ad9c;
  font-weight: 500;
}

.composer-note {
  display: block;
  width: 100%;
  min-height: 46px;
  padding: 6px 0 4px;
  border: 0;
  outline: none;
  background: transparent;
  color: var(--ink-soft);
  font-size: 13px;
  line-height: 1.75;
  resize: vertical;
}

.composer-note::placeholder {
  color: var(--faint);
}

.composer-note-lg {
  min-height: 72px;
  color: var(--ink);
  font-size: 14.5px;
  line-height: 1.9;
}

.composer-bar {
  display: flex;
  align-items: center;
  gap: 12px;
  padding-top: 12px;
  margin-top: 4px;
  border-top: 1px dashed var(--line);
}

.composer-fields {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.composer-hint {
  flex: 1;
  color: var(--faint);
  font-size: 10.5px;
  letter-spacing: 0.03em;
  text-align: right;
}

.composer-date {
  flex: 1;
  color: var(--muted);
  font-family: var(--font-display);
  font-size: 12px;
  letter-spacing: 0.04em;
}

.mini-field {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 5px 9px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: var(--paper-soft);
  color: var(--muted);
  font-size: 10.5px;
  white-space: nowrap;
}

.mini-field .icon {
  width: 13px;
  height: 13px;
  color: var(--faint);
}

.mini-field input[type="date"] {
  width: 108px;
  padding: 0;
  border: 0;
  outline: none;
  background: transparent;
  color: var(--ink-soft);
  font-size: 10.5px;
  font-variant-numeric: tabular-nums;
}

.mini-field input[type="date"]::-webkit-calendar-picker-indicator {
  opacity: 0.45;
  cursor: pointer;
}

/* ---------- buttons ---------- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 8px 16px;
  border: 1px solid transparent;
  border-radius: 999px;
  background: transparent;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.02em;
  white-space: nowrap;
  transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease,
    transform 0.2s ease, box-shadow 0.2s ease;
}

.btn .icon {
  width: 15px;
  height: 15px;
  stroke-width: 2;
}

.btn:active {
  transform: translateY(1px) scale(0.99);
}

.btn-primary {
  background: var(--ink);
  color: #fbf6ec;
  box-shadow: 0 8px 18px -12px rgba(43, 40, 34, 0.9);
}

.btn-primary:hover {
  background: var(--accent);
  box-shadow: 0 10px 22px -12px rgba(148, 68, 40, 0.8);
  transform: translateY(-1px);
}

.btn-ghost {
  border-color: var(--line);
  background: rgba(255, 253, 248, 0.6);
  color: var(--ink-soft);
}

.btn-ghost:hover {
  border-color: var(--line-strong);
  background: var(--paper);
  color: var(--ink);
}

.btn-text {
  padding: 6px 9px;
  color: var(--muted);
  font-weight: 500;
}

.btn-text:hover {
  color: var(--accent);
}

.btn-danger {
  color: var(--accent-deep);
}

.btn-danger:hover {
  background: var(--accent-soft);
}

/* ---------- image strip ---------- */
.image-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
  padding: 4px 0 2px;
  margin-top: 4px;
  border-radius: 12px;
  transition: background 0.2s ease, box-shadow 0.2s ease;
}

.image-strip.dragging {
  background: rgba(180, 91, 57, 0.06);
  box-shadow: inset 0 0 0 1px rgba(180, 91, 57, 0.3);
}

.img-thumb {
  position: relative;
  width: 72px;
  height: 72px;
  overflow: hidden;
  border-radius: 11px;
  background: var(--paper-deep);
  box-shadow: 0 1px 3px rgba(60, 45, 25, 0.12);
}

.img-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.35s ease;
}

.img-thumb:hover img {
  transform: scale(1.04);
}

.img-remove {
  position: absolute;
  top: 4px;
  right: 4px;
  display: grid;
  place-items: center;
  width: 18px;
  height: 18px;
  padding: 0;
  border: 1px solid rgba(255, 255, 255, 0.35);
  border-radius: 50%;
  background: rgba(38, 32, 24, 0.68);
  color: #fff;
  opacity: 0;
  transform: scale(0.85);
  transition: opacity 0.2s ease, transform 0.2s ease, background 0.2s ease;
  backdrop-filter: blur(2px);
}

.img-remove .icon {
  width: 10px;
  height: 10px;
  stroke-width: 2.2;
}

.img-thumb:hover .img-remove,
.img-remove:focus-visible {
  opacity: 1;
  transform: scale(1);
}

.img-remove:hover {
  background: var(--accent);
}

.img-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;
  width: 72px;
  height: 72px;
  padding: 0;
  border: 1px dashed var(--line-strong);
  border-radius: 11px;
  background: rgba(250, 245, 235, 0.5);
  color: var(--faint);
  font-size: 9.5px;
  transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
}

.img-add .icon {
  width: 19px;
  height: 19px;
  stroke-width: 1.4;
}

.img-add:hover {
  border-color: var(--accent);
  background: var(--accent-soft);
  color: var(--accent-deep);
}

.img-add.is-loading {
  pointer-events: none;
  opacity: 0.6;
}

.img-max {
  align-self: center;
  color: var(--faint);
  font-size: 10px;
}

.image-hint {
  color: var(--faint);
  font-size: 10px;
  white-space: nowrap;
}

/* ---------- content ---------- */
.content {
  min-height: 240px;
}

/* ---------- cards ---------- */
.item-card {
  position: relative;
  border: 1px solid var(--line);
  border-radius: 15px;
  background: var(--paper);
  box-shadow: var(--shadow-sm);
  transition: border-color 0.22s ease, box-shadow 0.22s ease, transform 0.22s ease;
  animation: rise 0.4s var(--ease) both;
  animation-delay: var(--delay, 0ms);
}

.card-actions {
  display: flex;
  flex: none;
  gap: 2px;
  opacity: 0;
  transform: translateX(4px);
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.item-card:hover .card-actions,
.item-card:focus-within .card-actions {
  opacity: 1;
  transform: none;
}

.icon-btn {
  display: grid;
  place-items: center;
  width: 29px;
  height: 29px;
  padding: 0;
  border: 0;
  border-radius: 8px;
  background: transparent;
  color: var(--faint);
  transition: background 0.2s ease, color 0.2s ease;
}

.icon-btn .icon {
  width: 15px;
  height: 15px;
}

.icon-btn:hover {
  background: var(--paper-deep);
  color: var(--ink);
}

.icon-btn.danger:hover {
  background: var(--accent-soft);
  color: var(--accent-deep);
}

/* plan */
.plan-list {
  display: flex;
  flex-direction: column;
  gap: 11px;
}

.plan-card {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  padding: 17px 16px 17px 18px;
}

.plan-card:hover {
  border-color: var(--line-strong);
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
}

.check-btn {
  position: relative;
  display: grid;
  flex: none;
  place-items: center;
  width: 25px;
  height: 25px;
  padding: 0;
  margin-top: 2px;
  border: 1.5px solid var(--line-strong);
  border-radius: 50%;
  background: transparent;
  color: transparent;
  transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease,
    transform 0.2s ease;
}

.check-btn::after {
  content: "点一下完成";
  position: absolute;
  left: 50%;
  bottom: calc(100% + 8px);
  z-index: 4;
  padding: 3px 8px;
  border-radius: 6px;
  background: var(--ink);
  color: #fbf6ec;
  font-size: 9.5px;
  letter-spacing: 0.02em;
  white-space: nowrap;
  opacity: 0;
  pointer-events: none;
  transform: translateX(-50%) translateY(3px);
  transition: opacity 0.18s ease, transform 0.18s ease;
}

.check-btn:hover::after {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}

.check-btn .icon {
  width: 14px;
  height: 14px;
  stroke-width: 2.4;
}

.plan-card:hover .check-btn {
  border-color: var(--green);
}

.check-btn:hover {
  border-color: var(--green);
  background: var(--green);
  color: #fff;
  transform: scale(1.08);
}

.plan-main {
  flex: 1;
  min-width: 0;
}

.plan-title {
  margin: 0;
  font-size: 15.5px;
  font-weight: 600;
  line-height: 1.55;
  letter-spacing: 0.01em;
  word-break: break-word;
}

.plan-note {
  margin: 4px 0 0;
  color: var(--muted);
  font-size: 12.5px;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-word;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.meta-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px 12px;
  margin-top: 8px;
  color: var(--faint);
  font-size: 10.5px;
}

.meta {
  display: inline-flex;
  align-items: center;
  gap: 4px;
}

.meta .icon {
  width: 12px;
  height: 12px;
  stroke-width: 1.6;
}

.due-chip {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 1px 8px;
  border-radius: 999px;
  background: var(--paper-deep);
  color: var(--ink-soft);
  font-size: 10px;
  white-space: nowrap;
}

.due-chip .icon {
  width: 11px;
  height: 11px;
}

.due-chip.is-soon {
  background: var(--accent-soft);
  color: var(--accent-deep);
}

.due-chip.is-overdue {
  background: #f3dfd6;
  color: #a13e27;
}

.plan-card.is-completing {
  pointer-events: none;
  animation: complete-out 0.38s var(--ease) forwards;
}

/* done */
.done-summary {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 16px 19px;
  margin-bottom: 28px;
  border: 1px solid var(--line);
  border-radius: 18px;
  background: linear-gradient(100deg, rgba(229, 237, 221, 0.7), rgba(255, 253, 248, 0.55));
  animation: rise 0.45s var(--ease) both;
}

.done-summary-icon {
  display: grid;
  flex: none;
  place-items: center;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: var(--paper);
  color: var(--green);
  box-shadow: var(--shadow-sm);
}

.done-summary-icon .icon {
  width: 21px;
  height: 21px;
  stroke-width: 1.8;
}

.done-summary-text {
  flex: 1;
  min-width: 0;
}

.done-summary-text strong {
  display: block;
  font-family: var(--font-display);
  font-size: 16px;
  font-weight: 600;
  letter-spacing: 0.03em;
}

.done-summary-text em {
  margin: 0 3px;
  color: var(--green);
  font-style: normal;
  font-size: 19px;
}

.done-summary-text p {
  margin: 2px 0 0;
  color: var(--muted);
  font-size: 11px;
}

.done-groups {
  display: flex;
  flex-direction: column;
  gap: 26px;
}

.group-head {
  display: flex;
  align-items: center;
  gap: 9px;
  margin-bottom: 10px;
  padding: 0 3px;
}

.group-title {
  color: var(--ink-soft);
  font-family: var(--font-display);
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 0.06em;
}

.group-date {
  color: var(--faint);
  font-size: 10.5px;
}

.group-line {
  flex: 1;
  height: 1px;
  background: var(--line);
}

.group-count {
  color: var(--faint);
  font-size: 10px;
  font-variant-numeric: tabular-nums;
}

.done-list {
  display: flex;
  flex-direction: column;
  gap: 9px;
}

.done-card {
  display: flex;
  align-items: flex-start;
  gap: 13px;
  padding: 15px 15px 15px 17px;
  background: rgba(255, 253, 248, 0.7);
}

.done-card:hover {
  background: var(--paper);
  border-color: var(--line-strong);
}

.done-check {
  display: grid;
  flex: none;
  place-items: center;
  width: 24px;
  height: 24px;
  margin-top: 1px;
  border-radius: 50%;
  background: var(--green-soft);
  color: var(--green);
}

.done-check .icon {
  width: 13px;
  height: 13px;
  stroke-width: 2.3;
}

.done-main {
  flex: 1;
  min-width: 0;
}

.done-title {
  margin: 0;
  color: var(--muted);
  font-size: 14.5px;
  font-weight: 500;
  line-height: 1.55;
  text-decoration: line-through;
  text-decoration-color: rgba(142, 133, 119, 0.45);
  text-decoration-thickness: 1px;
  word-break: break-word;
}

.done-note {
  margin: 3px 0 0;
  color: var(--faint);
  font-size: 11.5px;
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-word;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.done-meta {
  margin-top: 5px;
  color: var(--faint);
  font-size: 10px;
}

.undo-btn {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 4px 9px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: transparent;
  color: var(--muted);
  font-size: 10px;
  transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
}

.undo-btn .icon {
  width: 11px;
  height: 11px;
}

.undo-btn:hover {
  border-color: var(--green);
  background: var(--green-soft);
  color: var(--green-deep);
}

/* daily */
.daily-groups {
  display: flex;
  flex-direction: column;
  gap: 30px;
}

.daily-group {
  display: grid;
  grid-template-columns: 58px minmax(0, 1fr);
  gap: 22px;
  animation: rise 0.4s var(--ease) both;
}

.daily-rail {
  padding-top: 3px;
  text-align: right;
}

.day-num {
  font-family: var(--font-display);
  font-size: 27px;
  font-weight: 600;
  line-height: 1;
  letter-spacing: 0.01em;
}

.day-month {
  margin-top: 5px;
  color: var(--accent);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.1em;
}

.day-week {
  margin-top: 2px;
  color: var(--faint);
  font-size: 9.5px;
  letter-spacing: 0.08em;
}

.daily-stream {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding-left: 22px;
  padding-bottom: 2px;
  border-left: 1px solid var(--line);
}

.daily-card {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 15px 15px 15px 17px;
}

.daily-card::before {
  content: "";
  position: absolute;
  top: 23px;
  left: -27px;
  width: 7px;
  height: 7px;
  border: 2px solid var(--bg);
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 0 1px rgba(180, 91, 57, 0.28);
}

.daily-card:hover {
  border-color: var(--line-strong);
  box-shadow: var(--shadow-md);
  transform: translateY(-1px);
}

.daily-main {
  flex: 1;
  min-width: 0;
}

.daily-time {
  display: flex;
  align-items: center;
  gap: 4px;
  margin-bottom: 5px;
  color: var(--faint);
  font-size: 9.5px;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.08em;
}

.daily-time .icon {
  width: 10px;
  height: 10px;
}

.daily-text {
  margin: 0;
  color: var(--ink-soft);
  font-size: 13.5px;
  line-height: 1.85;
  white-space: pre-wrap;
  word-break: break-word;
}

/* goods */
.goods-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
  gap: 18px;
}

.goods-card {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  cursor: pointer;
  animation: rise 0.4s var(--ease) both;
  animation-delay: var(--delay, 0ms);
}

.goods-card:hover {
  border-color: var(--line-strong);
  box-shadow: var(--shadow-md);
  transform: translateY(-3px);
}

.goods-cover {
  position: relative;
  aspect-ratio: 4 / 3;
  overflow: hidden;
  background: linear-gradient(145deg, #f0e7d6, #e3d6bf);
}

.goods-cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s var(--ease);
}

.goods-card:hover .goods-cover img {
  transform: scale(1.045);
}

.goods-open {
  position: absolute;
  inset: 0;
  z-index: 1;
  padding: 0;
  border: 0;
  border-radius: inherit;
  background: transparent;
  cursor: pointer;
}

.goods-open:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: -3px;
  border-radius: 15px;
}

.goods-cover.is-empty {
  display: grid;
  place-items: center;
  color: #b3a184;
  background:
    radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.65), transparent 55%),
    linear-gradient(145deg, #f0e7d6, #e5d9c4);
}

.goods-cover.is-empty .icon {
  width: 34px;
  height: 34px;
  stroke-width: 1.1;
  opacity: 0.7;
}

.goods-card .card-actions {
  position: absolute;
  top: 8px;
  right: 8px;
  z-index: 2;
  gap: 3px;
  padding: 3px;
  border-radius: 9px;
  background: rgba(255, 253, 248, 0.82);
  box-shadow: 0 2px 8px rgba(50, 40, 25, 0.12);
  backdrop-filter: blur(6px);
}

.goods-card .icon-btn {
  width: 25px;
  height: 25px;
}

.goods-card .icon-btn .icon {
  width: 13px;
  height: 13px;
}

.img-count {
  position: absolute;
  right: 9px;
  bottom: 9px;
  display: inline-flex;
  align-items: center;
  gap: 3px;
  padding: 2px 7px;
  border-radius: 999px;
  background: rgba(35, 30, 23, 0.55);
  color: #fdf8ee;
  font-size: 9px;
  font-variant-numeric: tabular-nums;
  backdrop-filter: blur(3px);
}

.img-count .icon {
  width: 10px;
  height: 10px;
}

.goods-body {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 5px;
  padding: 14px 15px 13px;
}

.goods-title {
  margin: 0;
  font-size: 14.5px;
  font-weight: 600;
  line-height: 1.5;
  letter-spacing: 0.01em;
  word-break: break-word;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.goods-note {
  margin: 0;
  color: var(--muted);
  font-size: 11.5px;
  line-height: 1.7;
  word-break: break-word;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.goods-foot {
  display: flex;
  align-items: center;
  margin-top: auto;
  padding-top: 7px;
  color: var(--faint);
  font-size: 9.5px;
  letter-spacing: 0.03em;
}

.goods-foot .dot-sep {
  margin: 0 5px;
  opacity: 0.6;
}

/* ---------- empty ---------- */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 58px 24px 52px;
  border: 1px dashed var(--line-strong);
  border-radius: 20px;
  background: rgba(255, 253, 248, 0.42);
  text-align: center;
  animation: rise 0.45s var(--ease) both;
}

.empty-art {
  position: relative;
  display: grid;
  place-items: center;
  width: 92px;
  height: 92px;
  margin-bottom: 17px;
  border-radius: 50%;
  color: var(--accent);
  background:
    radial-gradient(circle at 35% 30%, rgba(255, 255, 255, 0.9), transparent 60%),
    var(--accent-soft);
}

.empty-art::after {
  content: "";
  position: absolute;
  inset: -7px;
  border: 1px dashed rgba(180, 91, 57, 0.22);
  border-radius: 50%;
}

.empty-art .icon {
  width: 38px;
  height: 38px;
  stroke-width: 1.25;
}

.empty h3 {
  margin: 0;
  font-family: var(--font-display);
  font-size: 19px;
  font-weight: 600;
  letter-spacing: 0.05em;
}

.empty p {
  max-width: 310px;
  margin: 8px 0 18px;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.8;
}

.empty .btn {
  padding: 8px 17px;
}

.empty-search .empty-art {
  color: var(--muted);
  background: rgba(255, 253, 248, 0.7);
}

.empty-search .empty-art::after {
  border-color: var(--line);
}

/* ---------- modal ---------- */
.modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 80;
  display: grid;
  place-items: center;
  padding: 26px;
  background: rgba(38, 33, 26, 0.4);
  backdrop-filter: blur(5px);
  -webkit-backdrop-filter: blur(5px);
  animation: fade 0.22s ease both;
}

.modal {
  width: min(550px, 100%);
  max-height: 88vh;
  overflow: auto;
  border: 1px solid rgba(255, 255, 255, 0.6);
  border-radius: 22px;
  background: var(--paper);
  box-shadow: var(--shadow-lg);
  animation: pop 0.28s var(--ease) both;
}

.modal-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  padding: 23px 24px 0;
}

.modal-head .eyebrow {
  margin-bottom: 5px;
}

.modal-head h2 {
  margin: 0;
  font-family: var(--font-display);
  font-size: 25px;
  font-weight: 600;
  letter-spacing: 0.04em;
}

.modal-x {
  display: grid;
  flex: none;
  place-items: center;
  width: 32px;
  height: 32px;
  padding: 0;
  margin-top: 2px;
  border: 0;
  border-radius: 50%;
  background: var(--paper-soft);
  color: var(--muted);
  transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
}

.modal-x:hover {
  background: var(--paper-deep);
  color: var(--ink);
  transform: rotate(90deg);
}

.modal-x .icon {
  width: 15px;
  height: 15px;
}

.modal:focus {
  outline: none;
}

.field input:focus-visible,
.field textarea:focus-visible,
.field input[type="date"]:focus-visible,
.composer input:focus-visible,
.composer textarea:focus-visible,
.mini-field input:focus-visible,
.search-box input:focus-visible {
  outline: none;
}

.modal-body {
  display: flex;
  flex-direction: column;
  gap: 15px;
  padding: 20px 24px 10px;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.field > span,
.field-label {
  color: var(--muted);
  font-size: 10.5px;
  font-weight: 600;
  letter-spacing: 0.08em;
}

.field input[type="text"],
.field textarea,
.field input[type="date"] {
  width: 100%;
  padding: 10px 12px;
  border: 1px solid var(--line);
  border-radius: 11px;
  outline: none;
  background: var(--paper-soft);
  color: var(--ink);
  font-size: 13.5px;
  line-height: 1.7;
  transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
}

.field textarea {
  min-height: 104px;
  resize: vertical;
}

.field input:focus,
.field textarea:focus {
  border-color: rgba(180, 91, 57, 0.4);
  background: var(--paper);
  box-shadow: 0 0 0 4px rgba(180, 91, 57, 0.055);
}

.field input::placeholder,
.field textarea::placeholder {
  color: var(--faint);
}

.modal-foot {
  display: flex;
  justify-content: flex-end;
  gap: 9px;
  padding: 16px 24px 22px;
  margin-top: 8px;
  border-top: 1px dashed var(--line);
}

.modal-note {
  margin: 0;
  color: var(--faint);
  font-size: 10.5px;
  line-height: 1.7;
}

/* detail modal */
.detail-modal {
  position: relative;
  width: min(890px, 100%);
  overflow: auto;
  overscroll-behavior: contain;
}

.detail-modal .modal-x {
  position: absolute;
  top: 14px;
  right: 14px;
  z-index: 3;
  background: rgba(255, 253, 248, 0.86);
  box-shadow: 0 2px 8px rgba(40, 30, 18, 0.12);
  backdrop-filter: blur(6px);
}

.detail-layout {
  display: grid;
  grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
  min-height: 430px;
}

.detail-layout.no-images {
  display: block;
  min-height: 0;
}

.detail-gallery {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 22px;
  background: linear-gradient(160deg, #ece2d0, #e0d3bd);
}

.detail-main {
  position: relative;
  flex: none;
  width: 100%;
  aspect-ratio: 4 / 3;
  overflow: hidden;
  border-radius: 14px;
  background: #ded1bb;
  box-shadow: 0 14px 32px -20px rgba(70, 50, 25, 0.55);
  cursor: zoom-in;
}

.detail-main img {
  width: 100%;
  height: 100%;
  max-height: 56vh;
  object-fit: contain;
}

.detail-main::after {
  content: "点击查看大图";
  position: absolute;
  left: 10px;
  bottom: 10px;
  padding: 3px 9px;
  border-radius: 999px;
  background: rgba(35, 30, 23, 0.48);
  color: #fdf8ee;
  font-size: 9px;
  letter-spacing: 0.04em;
  opacity: 0;
  transition: opacity 0.2s ease;
  backdrop-filter: blur(3px);
}

.detail-main:hover::after {
  opacity: 1;
}

.detail-thumbs {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.detail-thumb {
  width: 43px;
  height: 43px;
  padding: 0;
  overflow: hidden;
  border: 2px solid transparent;
  border-radius: 8px;
  background: #e6dcc9;
  opacity: 0.65;
  transition: opacity 0.2s ease, border-color 0.2s ease;
}

.detail-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.detail-thumb:hover {
  opacity: 1;
}

.detail-thumb.active {
  border-color: var(--accent);
  opacity: 1;
}

.detail-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
  padding: 44px 32px 28px;
}

.detail-info .eyebrow {
  margin-bottom: 9px;
}

.detail-title {
  margin: 0 0 13px;
  font-family: var(--font-display);
  font-size: 27px;
  font-weight: 600;
  line-height: 1.35;
  letter-spacing: 0.04em;
  word-break: break-word;
}

.detail-note {
  margin: 0;
  color: var(--ink-soft);
  font-size: 13px;
  line-height: 1.95;
  white-space: pre-wrap;
  word-break: break-word;
}

.detail-note.is-empty {
  color: var(--faint);
  font-size: 12px;
}

.detail-meta {
  margin-top: 18px;
  padding-top: 13px;
  border-top: 1px dashed var(--line);
  color: var(--faint);
  font-size: 10.5px;
  letter-spacing: 0.04em;
}

.detail-actions {
  display: flex;
  gap: 8px;
  margin-top: auto;
  padding-top: 22px;
}

.detail-info .btn {
  padding: 7px 14px;
  font-size: 11px;
}

/* lightbox */
.lightbox {
  position: fixed;
  inset: 0;
  z-index: 110;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(22, 19, 15, 0.93);
  animation: fade 0.2s ease both;
}

.lightbox img {
  max-width: 90vw;
  max-height: 82vh;
  object-fit: contain;
  border-radius: 4px;
  box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
  animation: zoom-in 0.25s var(--ease) both;
}

.lightbox-close {
  position: absolute;
  top: 22px;
  right: 24px;
  display: grid;
  place-items: center;
  width: 38px;
  height: 38px;
  padding: 0;
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  color: #f3ede2;
  transition: background 0.2s ease;
}

.lightbox-close:hover {
  background: rgba(255, 255, 255, 0.18);
}

.lightbox-close .icon {
  width: 17px;
  height: 17px;
}

.lightbox-nav {
  position: absolute;
  top: 50%;
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
  padding: 0;
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.07);
  color: #f3ede2;
  transform: translateY(-50%);
  transition: background 0.2s ease;
}

.lightbox-nav:hover {
  background: rgba(255, 255, 255, 0.18);
}

.lightbox-nav .icon {
  width: 19px;
  height: 19px;
}

.lightbox-nav.prev {
  left: 26px;
}

.lightbox-nav.next {
  right: 26px;
}

.lightbox-counter {
  position: absolute;
  bottom: 22px;
  left: 50%;
  padding: 3px 11px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.09);
  color: rgba(245, 238, 226, 0.8);
  font-size: 10.5px;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.1em;
  transform: translateX(-50%);
}

/* ---------- toast ---------- */
.toast-root {
  position: fixed;
  left: 50%;
  bottom: 28px;
  z-index: 120;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  transform: translateX(-50%);
  pointer-events: none;
}

.toast {
  display: flex;
  align-items: center;
  gap: 15px;
  max-width: min(420px, calc(100vw - 32px));
  padding: 10px 16px;
  border: 1px solid rgba(255, 255, 255, 0.09);
  border-radius: 12px;
  background: #29261f;
  color: #f8f2e7;
  box-shadow: 0 14px 34px -14px rgba(0, 0, 0, 0.55);
  font-size: 12px;
  line-height: 1.5;
  pointer-events: auto;
  animation: toast-in 0.28s var(--ease) both;
}

.toast.is-leaving {
  animation: toast-out 0.2s ease forwards;
}

.toast-text {
  flex: 1;
  min-width: 0;
}

.toast-action {
  flex: none;
  padding: 2px 0;
  border: 0;
  background: none;
  color: #e7ad88;
  font-size: 11.5px;
  font-weight: 600;
  letter-spacing: 0.04em;
}

.toast-action:hover {
  color: #ffd2b3;
}

.toast-check {
  display: grid;
  flex: none;
  place-items: center;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: rgba(125, 153, 115, 0.28);
  color: #b9d3ae;
}

.toast-check .icon {
  width: 11px;
  height: 11px;
  stroke-width: 2.4;
}

/* ---------- confetti ---------- */
.confetti-layer {
  position: fixed;
  inset: 0;
  z-index: 130;
  overflow: hidden;
  pointer-events: none;
}

.confetti-piece {
  position: absolute;
  width: 7px;
  height: 7px;
  border-radius: 1.5px;
  will-change: transform, opacity;
}

/* ---------- utilities / animations ---------- */
@keyframes rise {
  from {
    opacity: 0;
    transform: translateY(9px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fade {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes pop {
  from {
    opacity: 0;
    transform: translateY(10px) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes zoom-in {
  from {
    opacity: 0;
    transform: scale(0.96);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes toast-in {
  from {
    opacity: 0;
    transform: translateY(12px) scale(0.98);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

@keyframes toast-out {
  to {
    opacity: 0;
    transform: translateY(6px) scale(0.98);
  }
}

@keyframes complete-out {
  40% {
    border-color: rgba(93, 124, 87, 0.5);
  }
  to {
    opacity: 0;
    transform: translateX(26px) scale(0.97);
  }
}

@keyframes stamp-pulse {
  0%,
  100% {
    transform: scale(1) rotate(0);
  }
  50% {
    transform: scale(1.04) rotate(-2deg);
  }
}

@keyframes shake {
  0%,
  100% {
    transform: translateX(0);
  }
  20% {
    transform: translateX(-5px);
  }
  40% {
    transform: translateX(5px);
  }
  60% {
    transform: translateX(-3px);
  }
  80% {
    transform: translateX(3px);
  }
}

.shake {
  animation: shake 0.4s ease;
  border-color: rgba(180, 91, 57, 0.55) !important;
}

/* ---------- responsive ---------- */
@media (max-width: 1100px) {
  .sidebar {
    width: 244px;
    padding-left: 16px;
    padding-right: 16px;
  }

  .main {
    padding: 34px 32px 80px;
  }

  .page-heading h1 {
    font-size: 38px;
  }
}

@media (max-width: 920px) {
  .topbar {
    align-items: flex-start;
    flex-direction: column;
    gap: 18px;
  }

  .topbar-side {
    align-items: stretch;
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
  }

  .search-box {
    width: min(280px, 100%);
  }

  .today-chip {
    order: 2;
    align-self: center;
  }

  .page-heading h1 {
    font-size: 36px;
  }

  .detail-layout {
