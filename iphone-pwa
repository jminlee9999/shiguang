  .modal-head {
    padding: 19px 19px 0;
  }

  .modal-head h2 {
    font-size: 22px;
  }

  .modal-body {
    padding: 16px 19px 8px;
  }

  .modal-foot {
    padding: 14px 19px 18px;
  }

  .detail-modal {
    max-height: 92vh;
